[Unit]
Description=LSS full-product bounded compute broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=10001
WorkingDirectory=/opt/lss-full
Environment=PYTHONPATH=/opt/lss-full/backend
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/lss-full/broker.env
RuntimeDirectory=lss-full
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/test ! -e /run/lss-full/compute.sock
ExecStart=/opt/lss-full/python/bin/python -m app.multitenancy.compute_broker --socket /run/lss-full/compute.sock --image ${LSS_COMPUTE_IMAGE} --market-root ${LSS_PUBLIC_MARKET_DIR} --capacity 4
ExecStopPost=/usr/bin/rm -f /run/lss-full/compute.sock
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
