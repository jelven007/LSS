COMPOSE_PROJECT_NAME=lss-product-candidate

# Replace tags with immutable registry digests before deployment.
LSS_FULL_IMAGE=registry.example.com/lss/runtime@sha256:replace-me
LSS_COMPUTE_IMAGE=registry.example.com/lss/compute@sha256:replace-me
LSS_BROKER_IMAGE=registry.example.com/lss/broker@sha256:replace-me
LSS_CANDIDATE_POSTGRES_IMAGE=postgres:16@sha256:replace-me
LSS_CANDIDATE_NGINX_IMAGE=nginx:1.27-alpine@sha256:replace-me

LSS_FULL_ENV_FILE=/etc/lss-candidate/runtime.env
LSS_PLATFORM_ENV_FILE=/etc/lss-candidate/platform.env
LSS_CANDIDATE_POSTGRES_ENV_FILE=/etc/lss-candidate/postgres.env
LSS_CANDIDATE_ADMIN_ENV_FILE=/etc/lss-candidate/admin.env
LSS_CANDIDATE_NGINX_CONFIG=/opt/lss-candidate/source/product/deploy/candidate/nginx.conf
LSS_CANDIDATE_PG_BOOTSTRAP=/opt/lss-candidate/source/product/deploy/cell/pg/bootstrap.sh

LSS_PLATFORM_DATA_DIR=/var/lib/lss-candidate/platform
LSS_PLATFORM_CONFIG_DIR=/var/lib/lss-candidate/platform-config
LSS_PUBLIC_MARKET_DIR=/var/lib/lss-candidate/public
LSS_COMPUTE_SOCKET_DIR=/run/lss-candidate

LSS_CANDIDATE_PUBLIC_URL=https://candidate.shanao.asia
LSS_CANDIDATE_BIND_ADDRESS=127.0.0.1
LSS_CANDIDATE_HTTP_PORT=38080
LSS_CANDIDATE_PG_PORT=35432

LSS_FULL_API_WORKERS=4
LSS_COMPUTE_CAPACITY=2
LSS_COMPUTE_MEMORY_MB=4096
LSS_COMPUTE_CPUS=2
