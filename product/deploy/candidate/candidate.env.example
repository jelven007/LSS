COMPOSE_PROJECT_NAME=tsp-product-candidate

# Replace tags with immutable registry digests before deployment.
TSP_FULL_IMAGE=registry.example.com/tsp/runtime@sha256:replace-me
TSP_COMPUTE_IMAGE=registry.example.com/tsp/compute@sha256:replace-me
TSP_BROKER_IMAGE=registry.example.com/tsp/broker@sha256:replace-me
TSP_CANDIDATE_POSTGRES_IMAGE=postgres:16@sha256:replace-me
TSP_CANDIDATE_NGINX_IMAGE=nginx:1.27-alpine@sha256:replace-me

TSP_FULL_ENV_FILE=/etc/tsp-candidate/runtime.env
TSP_PLATFORM_ENV_FILE=/etc/tsp-candidate/platform.env
TSP_CANDIDATE_POSTGRES_ENV_FILE=/etc/tsp-candidate/postgres.env
TSP_CANDIDATE_ADMIN_ENV_FILE=/etc/tsp-candidate/admin.env
TSP_CANDIDATE_NGINX_CONFIG=/opt/tsp-candidate/source/product/deploy/candidate/nginx.conf
TSP_CANDIDATE_PG_BOOTSTRAP=/opt/tsp-candidate/source/product/deploy/cell/pg/bootstrap.sh

TSP_PLATFORM_DATA_DIR=/var/lib/tsp-candidate/platform
TSP_PLATFORM_CONFIG_DIR=/var/lib/tsp-candidate/platform-config
TSP_PUBLIC_MARKET_DIR=/var/lib/tsp-candidate/public
TSP_COMPUTE_SOCKET_DIR=/run/tsp-candidate

TSP_CANDIDATE_PUBLIC_URL=https://candidate.shanao.asia
TSP_CANDIDATE_BIND_ADDRESS=127.0.0.1
TSP_CANDIDATE_HTTP_PORT=38080
TSP_CANDIDATE_PG_PORT=35432

TSP_FULL_API_WORKERS=4
TSP_COMPUTE_CAPACITY=2
TSP_COMPUTE_MEMORY_MB=4096
TSP_COMPUTE_CPUS=2
