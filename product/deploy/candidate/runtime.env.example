TSP_CELL_ID=candidate
TSP_CELL_SCHEMA_VERSION=6
TSP_CELL_CONTROL_DSN=postgresql://tsp_runtime:replace-runtime-password@postgres:5432/tsp_control
TSP_CELL_DATA_DSN=postgresql://tsp_runtime:replace-runtime-password@postgres:5432/tsp_data_local
TSP_CELL_POOL_SIZE=4
TSP_CELL_MARKET_URL=http://platform:3018
TSP_CELL_MARKET_TOKEN=replace-independent-market-token
TSP_PLATFORM_ADMIN_TOKEN=replace-independent-admin-token
TSP_CELL_STREAM_TICKET_SECRET=replace-at-least-32-random-bytes
TSP_CELL_WEBHOOK_ORIGINS=["https://candidate.shanao.asia"]

AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURITY=ssl
AUTH_SMTP_USERNAME=no-reply@example.com
AUTH_SMTP_PASSWORD=replace-smtp-password
AUTH_SMTP_FROM_ADDRESS=no-reply@example.com

POLICY_SERVICE_URL=https://shanao.asia
POLICY_SERVICE_TOKEN=replace-policy-server-token
POLICY_SERVICE_TIMEOUT_SECONDS=30

PYTHONDONTWRITEBYTECODE=1
