LSS_CELL_ID=candidate
LSS_CELL_SCHEMA_VERSION=6
LSS_CELL_CONTROL_DSN=postgresql://lss_runtime:replace-runtime-password@postgres:5432/lss_control
LSS_CELL_DATA_DSN=postgresql://lss_runtime:replace-runtime-password@postgres:5432/lss_data_local
LSS_CELL_POOL_SIZE=4
LSS_CELL_MARKET_URL=http://platform:3018
LSS_CELL_MARKET_TOKEN=replace-independent-market-token
LSS_PLATFORM_ADMIN_TOKEN=replace-independent-admin-token
LSS_CELL_STREAM_TICKET_SECRET=replace-at-least-32-random-bytes
LSS_CELL_WEBHOOK_ORIGINS=["https://candidate.shanao.asia"]

AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURITY=ssl
AUTH_SMTP_USERNAME=no-reply@example.com
AUTH_SMTP_PASSWORD=replace-smtp-password
AUTH_SMTP_FROM_ADDRESS=no-reply@example.com

POLICY_SERVICE_URL=https://shanao.asia
POLICY_SERVICE_TOKEN=replace-policy-server-token
POLICY_SERVICE_TIMEOUT_SECONDS=30

PYTHONDONTWRITEBYTECODE=1
